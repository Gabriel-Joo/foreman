#!/bin/bash
# FOREMAN 터미널 — ttyd가 브라우저 연결마다 띄운다(11-10, bridge/terminal.py _supervise).
#   foreman-term-view <tmux 소켓> <기준 세션> <rcfile> [탭] [프로젝트]
# 탭 · 프로젝트는 iframe 주소 ?arg=<탭>&arg=<프로젝트>에서 온다(ttyd -a). 브리지 WS 프록시가 모양을 거르고 넘긴다.
#
# 탭마다 그룹 세션(<기준>-v-<탭>)을 만들어 붙는다 — 창(셸)은 기준 세션과 같은 것을 함께 쓰고, "지금 보이는 창"만 탭마다 따로다.
# 전에는 모든 탭이 기준 세션 하나에 붙어, 한 탭 · CC 부탁이 창을 바꾸면 다른 탭의 터미널도 끌려갔다.
# destroy-unattached — 연결이 끝나(탭을 닫음 · iframe을 다시 불러옴) 붙은 사람이 없어지면 그 그룹 세션은 사라진다(창 · 셸은 남는다).
# 탭이 없거나 모양이 틀리면 기준 세션에 그대로 붙는다(전과 같다).
sock=$1 base=$2 rc=$3 tab=${4:-} proj=${5:-}
T() { tmux -S "$sock" "$@"; }

T has-session -t "=$base" 2>/dev/null \
  || T new-session -d -s "$base" -x 160 -y 40 -c "$HOME" "bash --rcfile $rc -i"

if [[ ! $tab =~ ^[A-Za-z0-9_-]{6,40}$ ]]; then
  exec tmux -S "$sock" new-session -A -s "$base"
fi
view="$base-v-$tab"

# 같은 탭이 다시 붙음(iframe 다시 불러옴) — 앞 연결이 아직 안 끝났으면 그 세션에 붙는다. 그 사이 사라졌으면 아래에서 새로 만든다
if T has-session -t "=$view" 2>/dev/null; then
  tmux -S "$sock" attach-session -t "=$view" && exit 0
fi

T new-session -d -t "=$base" -s "$view" || exit 1
# set-option -t는 칸 대상이라 끝에 콜론이 있어야 한다("=이름"만 쓰면 "no such session"으로 조용히 실패해 옵션이 안 걸렸다)
T set-option -t "=$view:" status-left "[$base] "         # 상태줄 왼쪽에 긴 그룹 세션 이름 대신 기준 이름
# 휠로 위 출력 보기(11-11) — 세션 옵션이라 서버 전체(다른 CC 세션)에는 걸리지 않는다. 휠 올리면 복사 모드로 들어가고 맨 아래에서 저절로 나온다.
# 이 탭의 마우스 끌기는 tmux가 받는다(브라우저 글 선택은 Shift+끌기)
T set-option -t "=$view:" mouse on 2>/dev/null || true
if [[ $proj =~ ^[A-Za-z0-9_.-]{1,40}$ ]]; then
  T select-window -t "=$view:=$proj" 2>/dev/null           # 처음 보일 창(그 프로젝트 창이 있으면)
fi
# destroy-unattached는 붙은 뒤에 건다 — 붙은 사람이 없는 세션에 걸면 그 자리에서 사라진다.
# 붙기 전에 끊겨 남은 것은 브리지가 치운다(bridge/terminal.py sweep_views)
exec tmux -S "$sock" attach-session -t "=$view" \; set-option -t "=$view:" destroy-unattached on
