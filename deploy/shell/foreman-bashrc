# FOREMAN 터미널 패널의 셸(7단계) — tmux 세션 foreman-shell이 bash --rcfile 로 읽는다.
# 사람이 직접 치는 셸이다(sudo 암호 · SSH 패스프레이즈 · 레지스트리 로그인). 승인 정책은 걸리지 않고, 기록만 남긴다.
[ -f ~/.bashrc ] && . ~/.bashrc

# 기록 파일을 디스크에 남기지 않는다 — 명령에 섞인 비밀이 평문으로 쌓이지 않게(브리지에는 마스킹해서 남는다)
HISTFILE=
# 모든 명령을 기록한다 — ~/.bashrc의 ignoreboth면 앞에 공백을 붙인 명령 · 같은 명령 반복이 기록에서 빠진다
HISTCONTROL=
export FOREMAN_SHELL=1

__foreman_last_hist=""
__foreman_after_cmd() {
  local ec=$?
  local h cmd
  h="$(HISTTIMEFORMAT= builtin history 1)"
  # 빈 Enter면 기록이 그대로다 — 보내지 않는다
  [ -z "$h" ] && return $ec
  [ "$h" = "$__foreman_last_hist" ] && return $ec
  __foreman_last_hist="$h"
  # "  123  명령" / "  123* 명령"(고친 기록) → 명령
  if [[ $h =~ ^[[:space:]]*[0-9]+\*?[[:space:]]+(.*)$ ]]; then cmd="${BASH_REMATCH[1]}"; else cmd="$h"; fi
  # 괄호 안에서 띄운다 — 대화형 셸의 작업 알림("[1] 1234", "Done")이 화면에 찍히지 않게
  ( FOREMAN_CMD="$cmd" FOREMAN_EXIT="$ec" FOREMAN_CWD="$PWD" \
      /home/kopo17/AI_programming/foreman/scripts/foreman-shell-hook.sh >/dev/null 2>&1 & )
  return $ec
}
PROMPT_COMMAND="__foreman_after_cmd${PROMPT_COMMAND:+; $PROMPT_COMMAND}"
# 프로젝트마다 tmux 창(11-10, bridge/terminal.py window_for) — 창을 만들 때 FOREMAN_PROJECT를 넣는다. 처음부터 있던 창은 foreman
PS1="[${FOREMAN_PROJECT:-foreman}] $PS1"
