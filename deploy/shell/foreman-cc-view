#!/bin/bash
# 「CC 화면」 띄우는 창 — ttyd(-b /ccscreen)가 브라우저 연결마다 띄운다(11-14, bridge/terminal.py _supervise).
#   foreman-cc-view <tmux 소켓> <쉴 때 크기 WxH> <창 %N> <탭>
# 쉴 때 크기(80x24)는 브리지 상수 CC_REST_SIZE 하나에서 ttyd 고정 인자로 온다. 창 · 탭은 브라우저가 정하지 않는다 — 브라우저는
# 세션 번호만 보내고, 브리지 WS 프록시(/ccscreen/ws)가 쿠키 · 같은 출처 · DB(살아 있는 FOREMAN CC 세션) · 그 프로세스의 tmux 창을
# 확인한 뒤 ?arg=<창>&arg=<탭>으로 바꿔 ttyd에 넘긴다. 여기서도 모양과 그 창이 실제로 있는지 다시 본다 — 아무 tmux 세션에나 붙지 않게.
#
# 그 CC 세션의 tmux 세션에 그룹 세션 ccv-<탭>-<pid>를 만들어 붙는다. 창(CC)은 함께 쓰고 연결이 끝나면 그룹 세션만 사라진다.
# 크기(11-14 사용자, 368의 「크기를 바꾸지 않음」을 바꿈): 보는 동안 CC 창을 띄우는 창(xterm) 크기에 맞춘다.
#   - 붙을 때 창 옵션 window-size manual(표시 @foreman_ccview 1) + 이 그룹 세션에 client-resized 훅
#     `run-shell -C 'resize-window …#{client_width}…'` — 붙을 때와 띄우는 창 크기를 바꿀 때(화면이 놓을 때 한 번) 맞춘다.
#     resize-window 혼자는 #{…}를 풀지 않아 run-shell -C로 감쌌다(11-14 실험). 그룹 세션은 상태줄을 끈다(창 = 손님 크기).
#   - 둘이 같은 창을 보면 나중에 붙은 쪽 크기(사용자 결정 11-14) — 보기마다 자기 훅이 붙을 때 불리니 저절로 그렇다.
#     먼저 나간 쪽이 마지막이 아니면 남은 보기의 손님 크기로 다시 맞춘다
#   - 이 창을 보는 마지막 보기가 나가면 쉴 때 크기(80x24)로 되돌리고 window-size · 표시를 푼다. 죽어서 못 푼 것은 브리지가
#     같게 치운다(release_cc_windows)
#   - 창에 이미 다른 window-size가 있으면(표시 없음 — 사람이 정한 것) 크기를 건드리지 않고 보기만 한다
sock=$1 rest=${2:-} pane=${3:-} tab=${4:-}
T() { tmux -S "$sock" "$@"; }
MARK=@foreman_ccview
fail() {                          # 까닭을 화면에 띄우고 잠깐 둔다(곧바로 끝나면 ttyd가 다시 붙기만 되풀이한다)
  printf '\r\n  %s\r\n  [다시 붙기]를 누르면 다시 확인합니다.\r\n' "$1"
  read -r -t 600 -n 1 _ 2>/dev/null
  exit 1
}

[[ $rest =~ ^([0-9]{2,3})x([0-9]{2,3})$ ]] || fail "쉴 때 크기 설정이 올바르지 않습니다."
rest_w=${BASH_REMATCH[1]} rest_h=${BASH_REMATCH[2]}
[[ $pane =~ ^%[0-9]{1,7}$ ]] || fail "세션 창 대상이 올바르지 않습니다."
[[ $tab =~ ^[A-Za-z0-9_-]{6,40}$ ]] || fail "탭 표시가 올바르지 않습니다."
info=$(T display-message -p -t "$pane" '#{session_name}	#{window_id}' 2>/dev/null) \
  || fail "세션 창을 찾지 못했습니다 — 세션이 끝났을 수 있습니다."
base=${info%%$'\t'*} win=${info#*$'\t'}
[[ -n $base && $win =~ ^@[0-9]+$ ]] || fail "세션 창을 찾지 못했습니다."
view="ccv-$tab-$$"                # 연결마다 다른 이름 — 같은 탭이 곧바로 다시 붙어도 옛 연결의 뒷정리가 새 연결을 건드리지 않게

hold() {                          # 우리가 묶은 창(표시 있음)이거나 아무도 정하지 않은 창만 맞춘다
  local ws; ws=$(T show-options -wqv -t "$win" window-size)
  if [[ -n $ws && $(T show-options -wqv -t "$win" "$MARK" 2>/dev/null) != 1 ]]; then
    return 0                      # 사람이 정한 window-size — 보기만 한다
  fi
  T set-option -w -t "$win" window-size manual && T set-option -w -t "$win" "$MARK" 1 || return 0
  T set-hook -t "=$view:" client-resized "run-shell -C 'resize-window -t $win -x #{client_width} -y #{client_height}'"
}
others() {                        # 이 창을 보는 다른 CC 화면 세션(막 만들어져 붙는 중인 것도 센다)
  T list-windows -a -F '#{window_id} #{session_name}' 2>/dev/null \
    | awk -v w="$win" -v me="$view" '$1 == w && $2 ~ /^ccv-/ && $2 != me { print $2 }'
}
released=
release() {                       # 우리가 묶은 것이면: 다른 보기가 남았으면 그 크기로, 없으면 쉴 때 크기로 되돌리고 푼다
  [[ -n $released ]] && return 0
  released=1
  [[ $(T show-options -wqv -t "$win" "$MARK" 2>/dev/null) == 1 ]] || return 0
  local o sz
  o=$(others | head -n 1)
  if [[ -n $o ]]; then
    sz=$(T list-clients -t "=$o" -F '#{client_width} #{client_height}' 2>/dev/null | head -n 1)
    [[ $sz =~ ^([0-9]+)\ ([0-9]+)$ ]] && T resize-window -t "$win" -x "${BASH_REMATCH[1]}" -y "${BASH_REMATCH[2]}" 2>/dev/null
    return 0
  fi
  T resize-window -t "$win" -x "$rest_w" -y "$rest_h" 2>/dev/null
  T set-option -wu -t "$win" window-size 2>/dev/null
  T set-option -wu -t "$win" "$MARK" 2>/dev/null
}

# 같은 탭의 앞 연결(다른 세션을 보던 것일 수 있다)은 치우고 새로 만든다 — 창(CC)은 그대로 남는다
for old in $(T list-sessions -F '#{session_name}' 2>/dev/null | grep -E "^ccv-$tab-[0-9]+\$"); do
  T kill-session -t "=$old" 2>/dev/null
done
trap 'release; exit 0' HUP TERM INT
T new-session -d -t "=$base" -s "$view" || fail "세션 창에 붙지 못했습니다."
T set-option -t "=$view:" status off 2>/dev/null || true          # 상태줄 없이 — 띄우는 창 크기 = CC 창 크기
T set-option -t "=$view:" mouse off 2>/dev/null || true           # 셸과 같다 — 끌기는 브라우저 글 고르기가 받는다
T select-window -t "=$view:$win" 2>/dev/null                      # 보이는 창은 그룹 세션마다 따로 — CC 세션 쪽은 그대로
hold                              # 그룹 세션을 만든 뒤에 — 그 사이 끝나는 앞 연결의 release가 이 세션을 보고 풀지 않는다
# destroy-unattached는 붙은 뒤에 건다(붙기 전에 걸면 그 자리에서 사라진다). 붙기 전에 끊겨 남은 것은 브리지가 치운다.
# exec하지 않는다 — 연결이 끝난 뒤 크기를 되돌려야 한다. ignore-size: 사람이 정한 window-size(smallest 등)일 때 크기 계산에
# 끼지 않게(우리가 묶은 창은 훅이 맞춘다 — 훅은 ignore-size여도 불린다)
tmux -S "$sock" attach-session -f ignore-size -t "=$view" \; set-option -t "=$view:" destroy-unattached on
T kill-session -t "=$view" 2>/dev/null                             # 붙기 전에 끝났으면 남아 있다(이름이 연결마다라 남의 것은 아니다)
release
