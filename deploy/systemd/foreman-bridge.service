[Unit]
Description=FOREMAN bridge (FastAPI, 127.0.0.1:8000)
Documentation=file:///home/kopo17/AI_programming/foreman/docs/operations.md
# MySQL은 docker(foreman-mysql, restart=unless-stopped)가 올린다. 사용자 매니저는 docker 순서를 보장하지 않으므로
# DB가 아직 없으면 실패 → Restart로 다시 시도한다
StartLimitIntervalSec=300
StartLimitBurst=10
# 위 한도에 걸려 systemd가 포기하면(failed) 브리지 밖 알림 유닛을 부른다(11-15). 브리지가 없으니 브리지 알림은 못 간다
OnFailure=foreman-bridge-alert.service

[Service]
Type=simple
WorkingDirectory=/home/kopo17/AI_programming/foreman
ExecStart=/home/kopo17/AI_programming/foreman/.venv/bin/python -m bridge
Restart=on-failure
RestartSec=5
# tmux 명령(CC 세션 조회 · 입력 주입)이 PATH의 tmux를, 디스패처 · 인계 요약(claude -p)이 PATH의 claude를 쓴다.
# 11-08: claude는 ~/.npm-global/bin에 있는데 빠져 있어 systemd로 옮긴 11-06부터 디스패처가 "claude를 띄우지 못했습니다"였다
# (인계 요약도 같은 길 — 그 사이 요청이 없어 드러나지 않았다). 브리지는 기동 때 claude를 찾아 못 찾으면 로그 · 계획 거절 사유로 알린다
Environment=PATH=/home/kopo17/.npm-global/bin:/home/kopo17/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
KillMode=mixed
TimeoutStopSec=20

[Install]
WantedBy=default.target
