+      volumeMounts:
+        - { name: foreman-webhook, mountPath: /var/run/foreman, readOnly: true }
   volumes:
     - { name: buildkitd, emptyDir: {} }
+    - name: foreman-webhook     # optional — Secret이 없어도 Pod는 뜬다(알림만 빠진다)
+      secret: { secretName: foreman-webhook, optional: true }
 '''
     }
   }
