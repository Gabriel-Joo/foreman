--- a/Jenkinsfile
+++ b/Jenkinsfile
@@ -9,6 +9,28 @@
 //   전부 감시한다 — git 단계로 받으면 태그 push 가 빌드를 다시 부르고, 그 빌드가 또 push 하는 루프가 된다
 //
 // 2026-10-18 학교 환경(kaniko, std-harbor, std-gitlab gitops, BUILD_NUMBER 태그)에서 바꿨다
+//
+// FOREMAN 인과 체인(FOREMAN 로드맵 8단계): 빌드 시작 · 끝(결과 · 깨진 스테이지)을 FOREMAN 브리지 웹훅(호스트 192.168.122.1:8001)에 알린다.
+// - 알림이 실패해도 빌드 결과는 바뀌지 않는다(try/catch + curl || true, 5초). 토큰 Secret(jenkins/foreman-webhook)이 없으면 보내지 않는다
+// - 토큰은 Secret을 jnlp 컨테이너에 파일로 붙여 curl -H @파일로만 쓴다(명령줄 · 로그에 안 나온다)
+
+// FOREMAN에 이 빌드의 단계를 알린다
+def foreman(String phase) {
+  try {
+    withEnv(["FM_PHASE=${phase}", "FM_RESULT=${currentBuild.currentResult}", "FM_STAGE=${env.FOREMAN_STAGE ?: ''}"]) {
+      sh '''
+        set +x
+        [ -r /var/run/foreman/authorization ] || exit 0
+        body=$(printf '{"job":"%s","number":%s,"phase":"%s","result":"%s","stage":"%s","commit":"%s","url":"%s"}' \
+          "$JOB_NAME" "$BUILD_NUMBER" "$FM_PHASE" "$FM_RESULT" "$FM_STAGE" "${GIT_COMMIT:-}" "$BUILD_URL")
+        curl -sS -m 5 -o /dev/null -X POST -H 'Content-Type: application/json' -H @/var/run/foreman/authorization \
+          --data "$body" http://192.168.122.1:8001/webhooks/jenkins || true
+      '''
+    }
+  } catch (e) {
+    echo "FOREMAN 알림 실패(빌드와 무관): ${e}"
+  }
+}
 
 pipeline {
   agent {
@@ -36,8 +58,13 @@
