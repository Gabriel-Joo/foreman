{
  "name": "site",
  "label": "현장",
  "_comment": "10d 시트 테마 — docs/10_office_design.md 현장 열. 에셋이 가장 부족한 테마라 대부분 직접 그렸다(scripts/draw_props.py — 지게차 · 롤셔터 · 컴프레서 · 기름통 · 공구벽 · 작업대 · 간이침대 · 검사대 · 도면 탁자 · 철제 선반 · 선풍기 · 고깔 · 팔레트 · 트럭 · 게이지 · 안전모 걸이 · 무전기). Ninja Adventure에서 캐릭터 · 크레인 · 컨베이어 · 목재(camp). 바닥(콘크리트) · 벽(철판)은 엔진이 그린다",

  "palette": {
    "label": "#f4f1e8", "muted": "#b9b4a6",
    "ok": "#5dd39e", "warn": "#f2c14e", "bad": "#ff6b5b", "act": "#7aa7ff", "frozen": "#c9ced6",
    "orb": "#ffd27a", "candle": "#ffb347", "glass1": "#ffd27a", "glass2": "#ffffff", "glass3": "#ffd27a",
    "infraFloor": "#00000030", "lounge": "#3b3a36", "smoke": "#5b5560", "zz": "#ffffff",
    "wallCap": "#3a4654", "wallEdge": "#7d8fa0", "glassWall": "#ffd27a", "stripeA": "#f2c14e", "stripeB": "#2b2f3a"
  },

  "layout": {
    "tile": 16,
    "room": { "w": 28, "h": 18 },
    "lounge": { "w": 14, "h": 18 },
    "gap": 4,
    "grid": "../_shared/grid.json",
    "_grid": "11-10 모눈 — 방 칸 · 복도 · 출하 단계는 grid.json 한 벌(세 테마 같음). 아래 자리(seats · seat)는 그 방 왼쪽 위 기준, 방이 없는 묶음은 in으로 방을 고른다",
    "zones": {
      "foreman_office": { "_": "소장실(hq) — 유리벽 · 작업대 책상 · 무전기", "floor": "plate", "seat": [4.6, 1.65, "down"] },
      "manager": { "_": "관리자(11-09 사용자) — 소장실 안 옆자리. 관리자 세션이 있을 때만 선다(상주 아님). 일할 때도 이 자리", "in": "foreman_office",
                   "seats": [[6.3, 3.0, "left"], [2.4, 2.7, "right"]] },
      "store": { "_": "A 자재창고(read) — 철제선반, 목재, 통나무", "face": "up", "seats": [[3.6, 2.5], [4.4, 3.5], [2.7, 3.6]] },
      "tools": { "_": "C 공구실(bash) — 공구벽, 컴프레서, 기름통", "face": "up", "seats": [[3.2, 2.6], [1.0, 3.1], [2.3, 3.5]] },
      "gate": { "_": "G 셔터(web) — 바깥으로 나가는 방이라 위 · 오른쪽 벽에 붙였다. 롤셔터, 지게차, 크레인", "face": "up", "seats": [[2.6, 1.6], [2.6, 3.9]] },
      "camp": { "_": "F 함바(idle) — 간이침대 2, 그루터기 탁자, 선풍기", "floor": "plate",
                "seats": [[1.5, 2.6, "down"], [1.5, 4.3, "down"], [2.9, 2.6, "right"], [4.3, 4.7, "up"]] },
      "desks": { "_": "B 작업대(edit) — 작업대 두 줄. 왼쪽 열은 디자이너 자리", "seats": [[3.6, 2.6, "down"], [5.8, 2.6, "down"], [8.0, 2.6, "down"], [3.6, 4.3, "down"], [5.8, 4.3, "down"]] },
      "designer": { "_": "디자이너(11-10 사용자) — 작업대 왼쪽 열, 작업 책상 줄과 나란히. 디자이너 세션이 있을 때만 선다(상주 아님). 일할 때도 이 자리", "in": "desks",
                    "seats": [[1.4, 2.6, "down"], [1.4, 4.3, "down"]] },
      "coder_home": { "_": "코더 상주(11-09) — 세션이 없을 때 코더가 쉬는 자리(함바). 일하면 작업대로 간다. anim = 이 테마의 쉬는 동작", "in": "camp",
                      "seat": [5.5, 2.4, "left"], "anim": "coffee" },
      "scribe": { "_": "S 서류실(scribe) — 도면 탁자(쓰기) · 철제 선반(서가) · 계기 작업대(대조). 자리 순서 = 쓰기 · 서가 · 대조", "floor": "plate",
                  "seats": [[3.5, 1.35, "down"], [1.3, 4.9, "up"], [3.8, 3.65, "down"]] },
      "test": { "_": "D 검사대(test) — 검사대, 게이지", "seats": [[2.8, 1.65, "down"], [1.2, 3.3, "right"]] },
      "plans": { "_": "E 도면실(sub) — 큰 탁자, 밧줄, 두루마리통(Agent · 서브에이전트가 모인다)",
                 "seats": [[0.85, 3.05, "right"], [4.2, 3.05, "left"], [2.5, 2.6, "down"], [2.5, 4.35, "up"]] },
      "ship": { "_": "H 출하 접수대(git) — 팔레트, 송장. 출하장 바로 왼쪽(커밋 → ①)", "seats": [[2.5, 2.8, "up"]] },
      "infra": {
        "_": "출하장(ship) — 단계 칸 x는 grid.json ship. stands: 단계 왼쪽 위 기준(home은 출하장 기준)",
        "stands": { "jenkins": [1.3, 3.2], "harbor": [1.7, 3.2], "argocd": [1.8, 3.4], "home": [0.9, 3.3] },
        "jenkins": { "label": "검수대(Jenkins)" },
        "harbor": { "label": "팔레트(Harbor)" },
        "argocd": { "label": "트럭(ArgoCD)" }
      },
      "lounge_seats": { "x": 2, "y": 3, "cols": 3, "rows": 4, "dx": 4, "dy": 3 }
    }
  },

  "spawn": { "zone": "plans" },

  "tags": {
    "_": "구역 이름표 — 안전 노랑 표지판(검정 글씨, 빗금 띠)",
    "style": { "bg": "#f2c14e", "fg": "#141414", "border": "#141414", "font": "bold 14px ui-monospace, 'D2Coding', monospace", "kind": "hazard" },
    "_zones": "방 이름 — 이름표는 방 왼쪽 위 칸에 고정(11-10 모눈). 하는 일은 호버(office.js ZONE_ROLE)",
    "zones": { "foreman_office": "소장실", "store": "자재창고", "desks": "작업대", "tools": "공구실", "test": "검사대",
               "plans": "도면실", "camp": "함바", "gate": "셔터", "ship": "출하 접수대", "scribe": "서류실" },
    "_roles": "구역 → 하는 일(설명은 테마 공통, office.js ZONE_ROLE). 이름표에 마우스를 올리면 뜬다",
    "roles": { "foreman_office": "hq", "store": "read", "desks": "edit", "tools": "bash", "test": "test",
               "plans": "sub", "camp": "idle", "gate": "web", "ship": "git", "scribe": "scribe" },
    "_infra": "[이름표, 호버] — 이름표는 짧게(11-10), ① ② ③은 바닥 화살표 쪽",
    "infra": { "title": "출하장", "jenkins": ["검수대", "Jenkins 빌드"], "harbor": ["팔레트", "Harbor 이미지"], "argocd": ["트럭", "ArgoCD 배포"] }
  },

  "aura": { "_": "발밑 역할 색 원(11-13, js/aura.js) — hazard 끊긴 작업 구역 고리 · tape 바닥 테이프 모서리 · glow 번짐만. 견주기 ?aura=<꼴>|off. 색은 render.js ROLE_COLOR(역할 배지와 같은 값)", "style": "hazard" },
  "roles": {
    "_": "역할 → 안전모 색. 역할이 없으면 노란 안전모, 감독(foreman)은 흰 안전모. 색은 js/roles.js ROLE_CLOTH 한 표(11-15)이고 여기 colors는 현장만 다른 값(감독 흰색, 코더 짙은 파랑). 미리 보기 ?roles=demo",
    "mode": "helmet", "default": "#f2c14e", "foreman": "#f4f4f4",
    "colors": { "foreman": "#f4f4f4", "coder": "#2f6fb0" },
    "idle": { "_": "역할별 쉼 자리(12a) — 서기는 서류실에서 읽는다", "scribe": { "go": "scribe", "anim": "read" } }
  },

  "hq": {
    "_": "감독실(1단) = 감독 컨테이너. 공정표 화이트보드 + 현장마다 자석(작업중 파랑 · 쉼 초록 · 승인 · 실패 빨강 · 없음 회색)",
    "label": "소장실", "size": { "w": 28, "h": 16 }, "seat": [14.0, 9.7], "floor": "plate",
    "board": { "style": "whiteboard", "x": 3, "y": 0.4, "w": 22, "h": 5.4 },
    "decor": [
      { "s": "workbench", "x": 12.0, "y": 9.2 }, { "s": "workbench", "x": 14.0, "y": 9.2 },
      { "s": "radio", "x": 12.6, "y": 9.05, "z": "top" }, { "s": "mug", "x": 15.4, "y": 9.25, "z": "top" }, { "s": "newspaper", "x": 13.3, "y": 9.3, "z": "top" },
      { "s": "helmet_rack", "x": 1.0, "y": 0.6, "z": "wall" }, { "s": "helmet_rack", "x": 26.0, "y": 0.6, "z": "wall" },
      { "s": "drum_blue", "x": 2.0, "y": 11.0 }, { "s": "drum_red", "x": 2.8, "y": 11.2 }, { "s": "cone", "x": 24.2, "y": 12.0 }, { "s": "cone", "x": 25.0, "y": 12.2 },
      { "s": "fan", "x": 18.0, "y": 8.4 }, { "s": "steel_shelf", "x": 23.5, "y": 6.6 }, { "s": "log_stack", "x": 3.0, "y": 7.0 }
    ]
  },

  "states": {
    "ACTIVE":    { "anim": "walk", "go": "desk" },
    "IDLE":      { "anim": "idle", "go": "camp", "variants": ["lie", "coffee", "news"] },
    "WAITING":   { "anim": "wait", "go": "desk" },
    "SUSPENDED": { "anim": "still", "go": "desk", "fx": "stone" },
    "DORMANT":   { "anim": "stand", "go": "desk", "fx": "faded", "alpha": 0.35 }
  },

  "tools": [
    { "match": "Read|Grep|Glob|NotebookRead", "go": "store", "anim": "read" },
    { "match": "Edit|Write|MultiEdit|NotebookEdit", "go": "desk", "anim": "hammer" },
    { "match": "Bash", "target": "\\b(pytest|unittest|node --test|npm (run )?test|go test|mvn test|gradle test|jest|vitest|ruff|mypy|bash -n|py_compile)\\b", "go": "test", "anim": "gauge" },
    { "match": "Bash", "target": "(^|[;&|(]\\s*)git\\b", "go": "ship", "anim": "seal" },
    { "match": "Bash|BashOutput|KillShell", "go": "tools", "anim": "wrench" },
    { "match": "WebFetch|WebSearch", "go": "gate", "anim": "look" },
    { "match": "Agent|Task", "go": "plans", "anim": "cast", "spawn": true },
    { "match": "mcp__*", "go": "gate", "anim": "radio" },
    { "match": "TodoWrite|ExitPlanMode", "go": "desk", "anim": "think" },
    { "match": "*", "go": "desk", "anim": "hammer" }
  ],

  "flags": {
    "approval_pending": { "bubble": "!", "anim": "raise_wand", "priority": 30 },
    "stuck_turn":       { "bubble": "…", "priority": 20 },
    "error":            { "fx": "smoke", "priority": 10 }
  },

  "_courier": "출하 라인 담당 한 명(11-05) — 빌드를 따라 ① → ② → ③ 으로 걸어간다. char가 없으면 sprites.chars.infra.jenkins",
  "courier": { "name": "출하 반장" },
  "foreman": { "name": "소장" },
  "infra": {
    "running": { "anim": "work" },
    "success": { "anim": "idle" },
    "failed":  { "anim": "idle", "fx": "smoke" },
    "waiting": { "anim": "idle", "prop": "pause_sign" },
    "none":    { "anim": "idle", "alpha": 0.6 }
