    "_zones": "[이름, dx, dy] — 이름표가 사람 자리를 가리지 않게 비켜 둔 것(11-05 window.office.layoutPlan())",
    "zones": { "foreman_office": "소장실", "store": "자재창고", "desks": ["작업대", -0.4, 0], "tools": "공구실", "test": ["검사대", -0.8, 0],
               "plans": "도면실", "camp": "함바", "gate": "셔터", "ship": ["출하 접수대", 0, 0.9], "scribe": "서류실" },
    "_roles": "구역 → 하는 일(설명은 테마 공통, office.js ZONE_ROLE). 이름표에 마우스를 올리면 뜬다",
