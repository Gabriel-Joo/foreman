  "tags": {
    "_": "구역 이름표 — 흰 사인판 + 파란 띠",
    "style": { "bg": "#ffffffee", "fg": "#1f2430", "border": "#3d9ee6", "font": "600 10px system-ui, 'Noto Sans KR', sans-serif", "kind": "sign" },
    "_zones": "[이름, dx, dy] — 이름표가 사람 자리를 가리지 않게 비켜 둔 것(11-05 window.office.layoutPlan())",
    "zones": { "foreman_office": "팀장실", "library": "아카이브", "desks": ["워크스테이션", -1.2, 0], "server": "서버룸", "test": ["QA 부스", 0, 1.1],
               "meeting": "회의실", "lounge": ["라운지", 0, -0.5], "window": ["창가 바", -1.1, 0], "commit": ["커밋 데스크", 1.1, 0] },
    "_roles": "구역 → 하는 일(설명은 테마 공통, office.js ZONE_ROLE). 이름표에 마우스를 올리면 뜬다",
    "roles": { "foreman_office": "hq", "library": "read", "desks": "edit", "server": "bash", "test": "test",
               "meeting": "sub", "lounge": "idle", "window": "web", "commit": "git" },
    "infra": { "title": "배포 파이프", "jenkins": "빌드 모니터 · Jenkins 빌드", "harbor": "저장소 · Harbor 이미지", "argocd": "배포 보드 · ArgoCD 배포" }
  },

  "roles": {
    "_": "역할 → 사원증 끈 색(11단계에서 포먼이 캐릭터에 role을 붙이면 쓴다). 미리 보기 ?roles=demo",
    "mode": "lanyard",
    "colors": { "lead": "#d4a72c", "builder": "#3f7fd0", "reviewer": "#c0392b", "researcher": "#2e9e6a", "ops": "#8e44ad" }
  },

