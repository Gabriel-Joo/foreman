{
  "name": "office",
  "label": "오피스",
  "_comment": "10d 시트 테마 — docs/10_office_design.md 오피스 열. 2dPig Pixel Office(CC0) + 직접 그린 것(서버랙 · 화이트보드 · 복합기 · 빈백 · 커피머신 · 빌드 모니터 · 폰). 바닥 · 벽은 2dPig 색으로 엔진이 그린다. 좌표는 방 안 타일",

  "palette": {
    "label": "#f4f6f8", "muted": "#a9b4c4",
    "ok": "#5dd39e", "warn": "#f2c14e", "bad": "#ff6b6b", "act": "#7aa7ff", "frozen": "#9fd8ff",
    "orb": "#7fd1ff", "candle": "#ffd27a", "glass1": "#7fd1ff", "glass2": "#bfe8ff", "glass3": "#ffffff",
    "infraFloor": "#0000002a", "lounge": "#3a3550", "smoke": "#8a8f99", "zz": "#ffffff",
    "wallCap": "#8f98a6", "wallEdge": "#d9dde3", "glassWall": "#bfe8ff"
  },

  "layout": {
    "tile": 16,
    "room": { "w": 28, "h": 18 },
    "lounge": { "w": 14, "h": 18 },
    "gap": 4,
    "grid": "../_shared/grid.json",
    "_grid": "11-10 모눈 — 방 칸 · 복도 · 출하 단계는 grid.json 한 벌(세 테마 같음). 아래 자리(seats · seat)는 그 방 왼쪽 위 기준, 방이 없는 묶음은 in으로 방을 고른다",
    "zones": {
      "foreman_office": { "_": "팀장실(hq) — 유리벽, 듀얼 모니터", "floor": "carpet", "seat": [4.6, 1.4, "down"] },
      "manager": { "_": "관리자(11-09 사용자) — 팀장실 안 옆자리. 관리자 세션이 있을 때만 선다(상주 아님). 일할 때도 이 자리", "in": "foreman_office",
                   "seats": [[6.4, 2.9, "left"], [2.3, 2.6, "right"]] },
      "library": { "_": "A 아카이브(read) — 책장, 바인더, 복합기", "face": "up", "seats": [[3.4, 2.6], [2.2, 3.2], [3.6, 3.75]] },
      "server": { "_": "C 서버룸(bash) — 랙, LED, 유리벽", "face": "up", "seats": [[2.6, 2.6], [3.6, 2.6], [1.0, 3.0]] },
      "window": { "_": "G 창가 바(web) — 바깥으로 나가는 방이라 위 · 오른쪽 벽에 붙였다. 창밖 도시", "face": "up", "seats": [[1.65, 2.6], [4.05, 2.6], [2.8, 3.4]] },
      "lounge": { "_": "F 라운지(idle) — 소파 · 빈백 · 커피머신", "floor": "wood",
                  "seats": [[3.0, 1.8, "down"], [1.2, 3.8, "down"], [3.5, 4.4, "down"], [4.7, 3.0, "down"], [2.2, 2.6, "down"]] },
      "desks": { "_": "B 워크스테이션(edit) — 긴 책상 줄 + 아래 책상. 왼쪽은 디자이너 책상 둘", "seats": [[4.6, 2.05, "down"], [5.8, 2.05, "down"], [7.0, 2.05, "down"], [8.2, 2.05, "down"], [4.4, 4.15, "down"]] },
      "designer": { "_": "디자이너(11-10 사용자) — 워크스테이션 왼쪽 책상 둘, 코더 책상 줄과 나란히(책상 5자리와 따로). 디자이너 세션이 있을 때만 선다(상주 아님). 일할 때도 이 자리", "in": "desks",
                    "seats": [[1.1, 3.05, "down"], [2.75, 3.05, "down"]] },
      "scribe": { "_": "S 문서팀(scribe) — PC 책상(쓰기) · 책장(서가) · 서류 더미(대조). 자리 순서 = 쓰기 · 서가 · 대조",
                  "seats": [[2.8, 2.3, "down"], [4.1, 4.9, "up"], [1.1, 4.3, "down"]] },
      "coder_home": { "_": "코더 상주(11-09) — 세션이 없을 때 코더가 쉬는 자리(라운지 커피머신 옆). 일하면 책상으로 간다. anim = 이 테마의 쉬는 동작", "in": "lounge",
                      "seat": [4.6, 4.6, "right"], "anim": "coffee" },
      "test": { "_": "D QA 부스(test) — 테스트 모니터, 체크리스트. 책상 앞에서 모니터를 본다", "seats": [[2.4, 2.9, "up"], [0.9, 3.4, "right"]] },
      "meeting": { "_": "E 회의실(sub) — 화이트보드, 긴 테이블(Agent · 서브에이전트가 모인다)",
                   "seats": [[3.6, 2.2, "up"], [1.5, 3.25, "down"], [2.5, 3.25, "down"], [2.2, 4.85, "up"], [4.3, 3.6, "left"]] },
      "commit": { "_": "H 커밋 데스크(git) — 프린터. 배포 파이프 바로 왼쪽(커밋 → ①)", "seats": [[1.8, 2.6, "down"]] },
      "infra": {
        "_": "배포 파이프(ship) — 단계 칸 x는 grid.json ship. stands: 단계 왼쪽 위 기준(home은 배포 파이프 기준)",
        "stands": { "jenkins": [1.3, 3.2], "harbor": [3.6, 3.3], "argocd": [1.6, 3.2], "home": [0.9, 3.3] },
        "jenkins": { "label": "빌드 모니터(Jenkins)" },
        "harbor": { "label": "저장소(Harbor)" },
        "argocd": { "label": "배포 보드(ArgoCD)" }
      },
      "lounge_seats": { "x": 2, "y": 3, "cols": 3, "rows": 4, "dx": 4, "dy": 3 }
    }
  },

  "spawn": { "zone": "meeting" },

  "tags": {
    "_": "구역 이름표 — 흰 사인판 + 파란 띠",
    "style": { "bg": "#ffffffee", "fg": "#1f2430", "border": "#3d9ee6", "font": "600 14px system-ui, 'Noto Sans KR', sans-serif", "kind": "sign" },
    "_zones": "방 이름 — 이름표는 방 왼쪽 위 칸에 고정(11-10 모눈). 하는 일은 호버(office.js ZONE_ROLE)",
    "zones": { "foreman_office": "팀장실", "library": "아카이브", "desks": "워크스테이션", "server": "서버룸", "test": "QA 부스",
               "meeting": "회의실", "lounge": "라운지", "window": "창가 바", "commit": "커밋 데스크", "scribe": "문서팀" },
    "_roles": "구역 → 하는 일(설명은 테마 공통, office.js ZONE_ROLE). 이름표에 마우스를 올리면 뜬다",
    "roles": { "foreman_office": "hq", "library": "read", "desks": "edit", "server": "bash", "test": "test",
               "meeting": "sub", "lounge": "idle", "window": "web", "commit": "git", "scribe": "scribe" },
    "_infra": "[이름표, 호버] — 이름표는 짧게(11-10 — 「① 빌드 모니터 · Jenkins 빌드」였다), ① ② ③은 바닥 화살표 쪽",
    "infra": { "title": "배포 파이프", "jenkins": ["빌드 모니터", "Jenkins 빌드"], "harbor": ["저장소", "Harbor 이미지"], "argocd": ["배포 보드", "ArgoCD 배포"] }
  },

  "roles": {
    "_": "역할 → 사원증 끈 색. 이름은 DB · 디스패처와 같다(11-05 통일: foreman coder inspector cicd helper). 미리 보기 ?roles=demo",
    "mode": "lanyard",
    "colors": { "foreman": "#d4a72c", "coder": "#3f7fd0", "inspector": "#2e9e6a", "cicd": "#8e44ad", "scribe": "#b0713a", "manager": "#c0392b", "designer": "#d6408a", "helper": "#8a8f98" },
    "idle": { "_": "역할별 쉼 자리(12a) — 서기는 문서팀에서 읽는다", "scribe": { "go": "scribe", "anim": "read" } }
  },

  "hq": {
    "_": "감독실(1단) = 팀장실. 대형 모니터 월 — 현장마다 화면(작업중 파랑 · 쉼 초록 · 승인 노랑 깜빡 · 실패 빨강 깜빡 · 없음 꺼짐)",
    "label": "팀장실", "size": { "w": 28, "h": 16 }, "seat": [14.0, 9.6], "floor": "carpet",
    "board": { "style": "monitors", "x": 3, "y": 0.4, "w": 22, "h": 5.4 },
    "decor": [
      { "fx": "glasswall", "x": 0.6, "y": 1.9, "w": 26.8, "h": 13.4 },
      { "s": "table_l", "x": 11.5, "y": 9.0 }, { "s": "table_l", "x": 14.0, "y": 9.0 },
      { "s": "monitor_side", "x": 12.6, "y": 8.1, "z": "top" }, { "s": "pc", "x": 15.2, "y": 7.95, "z": "top" },
      { "s": "mug", "x": 14.9, "y": 8.95, "z": "top" }, { "s": "paper1", "x": 12.0, "y": 9.0, "z": "top" },
      { "s": "plant", "x": 1.6, "y": 6.6 }, { "s": "plant", "x": 25.4, "y": 6.6 }, { "s": "cat", "x": 18.0, "y": 11.4 },
      { "s": "shelf", "x": 2.0, "y": 10.4 }, { "s": "box_r", "x": 24.6, "y": 11.6 }, { "s": "box_b", "x": 24.6, "y": 12.1 },
      { "s": "chair_w", "x": 13.9, "y": 11.4 }
    ]
  },

  "states": {
    "ACTIVE":    { "anim": "walk", "go": "desk" },
    "IDLE":      { "anim": "idle", "go": "lounge", "variants": ["phone", "coffee", "read"] },
    "WAITING":   { "anim": "wait", "go": "desk" },
    "SUSPENDED": { "anim": "still", "go": "desk", "fx": "stone" },
    "DORMANT":   { "anim": "stand", "go": "desk", "fx": "faded", "alpha": 0.35 }
  },

  "tools": [
    { "match": "Read|Grep|Glob|NotebookRead", "go": "library", "anim": "read" },
    { "match": "Edit|Write|MultiEdit|NotebookEdit", "go": "desk", "anim": "write" },
    { "match": "Bash", "target": "\\b(pytest|unittest|node --test|npm (run )?test|go test|mvn test|gradle test|jest|vitest|ruff|mypy|bash -n|py_compile)\\b", "go": "test", "anim": "shake" },
    { "match": "Bash", "target": "(^|[;&|(]\\s*)git\\b", "go": "commit", "anim": "seal" },
    { "match": "Bash|BashOutput|KillShell", "go": "server", "anim": "stir" },
    { "match": "WebFetch|WebSearch", "go": "window", "anim": "look" },
    { "match": "Agent|Task", "go": "meeting", "anim": "cast", "spawn": true },
    { "match": "mcp__*", "go": "window", "anim": "look" },
    { "match": "TodoWrite|ExitPlanMode", "go": "desk", "anim": "think" },
    { "match": "*", "go": "desk", "anim": "write" }
  ],

  "flags": {
    "approval_pending": { "bubble": "?", "anim": "raise_wand", "priority": 30 },
    "stuck_turn":       { "bubble": "…", "priority": 20 },
    "error":            { "fx": "smoke", "priority": 10 }
  },

  "_courier": "출하 라인 담당 한 명(11-05) — 빌드를 따라 ① → ② → ③ 으로 걸어간다. char가 없으면 sprites.chars.infra.jenkins",
  "courier": { "name": "배포 담당" },
  "foreman": { "name": "팀장" },
  "infra": {
    "running": { "anim": "work" },
    "success": { "anim": "idle" },
    "failed":  { "anim": "idle", "fx": "smoke" },
    "waiting": { "anim": "idle", "prop": "pause_sign" },
    "none":    { "anim": "idle", "alpha": 0.6 }
  },

  "outside": {
    "_": "방 바깥(11-11 사용자) — 좌표 약속은 현장 theme.json outside와 같다. 오피스: 건물 밖 보도(보도블록 색 타일) · 벽에 붙은 화분 · 분리수거함 · 자판기 · 정수기 · 쌓인 상자, 길가 화분 · 개 · 고양이(모두 2dPig 시트 — 개 · 쓰레기통 · 정수기는 처음 쓴다)",
    "band": 0.75,
    "ground": { "a": "#b4b9c0", "b": "#bdc2c8", "grout": "#9da3ab", "tile": 1, "tileH": 0.5, "stagger": true },
