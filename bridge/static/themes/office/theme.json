    ],
    "fill": { "from": 12.6, "cell": [3, 3], "chance": 0.4, "jitter": 0.5, "items": ["plant", "bin_g", "plant", "bin_b", "box_r", "plant"] },
    "walkers": [{ "y": 3.0, "speed": 0.6, "x": 3 }, { "y": 3.0, "speed": -0.5, "x": 16, "char": 2 }, { "y": 6.0, "speed": -0.75, "x": 10, "char": 1 }, { "y": 14.6, "speed": 0.45, "x": 6, "char": 3 }]
  },
