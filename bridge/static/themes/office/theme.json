      { "s": "plant", "x": 11.6, "y": 0.0 },
      { "s": "plant", "x": 1.0, "y": 3.8 }, { "s": "dog", "x": 4.5, "y": 4.4 }, { "s": "plant", "x": 8.0, "y": 3.8 }, { "s": "cat", "x": 11.0, "y": 4.2 }
    ],
    "_layers": "보도 아래 연석 · 차도(가운데 노란 줄) · 건너편 보도. y는 띠 아래 끝 기준",
    "layers": [
      { "y": 6.6, "h": 0.25, "ground": { "a": "#8d939b", "grout": "#7d838b", "tile": 1 } },
      { "y": 6.85, "h": 5.4, "ground": { "a": "#4a4e55", "b": "#4f535a", "grout": "#4a4e55", "spot": "#5c6068", "tile": 2 } },
