  "roles": {
    "_": "역할 → 로브 색(11단계에서 포먼이 캐릭터에 role을 붙이면 쓴다). 렌더러가 옷 픽셀의 색상만 바꾼다. 미리 보기 ?roles=demo",
    "colors": { "lead": "#d4a72c", "builder": "#3f7fd0", "reviewer": "#c0392b", "researcher": "#2e9e6a", "ops": "#8e44ad" }
  },

