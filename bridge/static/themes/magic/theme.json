                   "seats": [[6.2, 3.3, "left"], [2.8, 2.6, "right"]] },
      "library": { "_": "A 서고(read) — 2층 책장 · 사다리", "face": "up", "seats": [[1.8, 2.9], [3.0, 3.4], [4.3, 3.0]] },
