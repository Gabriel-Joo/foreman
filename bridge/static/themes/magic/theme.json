  "states": {
    "ACTIVE":    { "anim": "walk", "go": "desk" },
    "IDLE":      { "anim": "idle", "go": "hall", "variants": ["sleep", "eat", "read"] },
    "WAITING":   { "anim": "wait", "go": "desk" },
    "SUSPENDED": { "anim": "still", "go": "desk", "fx": "stone" },
    "DORMANT":   { "anim": "stand", "go": "desk", "fx": "faded", "alpha": 0.35 }
  },

  "tools": [
    { "match": "Read|Grep|Glob|NotebookRead", "go": "library", "anim": "read" },
    { "match": "Edit|Write|MultiEdit|NotebookEdit", "go": "desk", "anim": "write" },
    { "match": "Bash", "target": "\\b(pytest|unittest|node --test|npm (run )?test|go test|mvn test|gradle test|jest|vitest|ruff|mypy|bash -n|py_compile)\\b", "go": "test", "anim": "shake" },
    { "match": "Bash", "target": "(^|[;&|(]\\s*)git\\b", "go": "seal", "anim": "seal" },
    { "match": "Bash|BashOutput|KillShell", "go": "potion", "anim": "stir" },
    { "match": "WebFetch|WebSearch", "go": "window", "anim": "look" },
    { "match": "Agent|Task", "go": "circle", "anim": "cast", "spawn": true },
    { "match": "mcp__*", "go": "window", "anim": "look" },
    { "match": "TodoWrite|ExitPlanMode", "go": "desk", "anim": "think" },
    { "match": "*", "go": "desk", "anim": "write" }
  ],

  "flags": {
    "approval_pending": { "bubble": "!", "anim": "raise_wand", "priority": 30 },
    "stuck_turn":       { "bubble": "…", "priority": 20 },
    "error":            { "fx": "smoke", "priority": 10 }
  },

  "_courier": "출하 라인 담당 한 명(11-05) — 빌드를 따라 ① → ② → ③ 으로 걸어간다. char가 없으면 sprites.chars.infra.jenkins",
