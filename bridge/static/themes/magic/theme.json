    "style": { "bg": "#ead9ae", "fg": "#3b2a1c", "border": "#8a6640", "font": "italic 600 15px Georgia, 'Noto Serif KR', serif", "kind": "parchment" },
    "_zones": "방 이름 — 이름표는 방 왼쪽 위 칸에 고정(11-10 모눈). 하는 일은 호버(office.js ZONE_ROLE)",
    "zones": { "foreman_office": "교장실", "library": "서고", "desks": "작업 책상", "potion": "물약실", "test": "시약대",
               "circle": "원탁방", "hall": "대강당", "window": "아치 창", "seal": "봉인대", "scribe": "필사실" },
    "_roles": "구역 → 하는 일(설명은 테마 공통, office.js ZONE_ROLE). 이름표에 마우스를 올리면 뜬다",
    "roles": { "foreman_office": "hq", "library": "read", "desks": "edit", "potion": "bash", "test": "test",
               "circle": "sub", "hall": "idle", "window": "web", "seal": "git", "scribe": "scribe" },
    "_infra": "[이름표, 호버] — 이름표는 짧게(11-10), ① ② ③은 바닥 화살표 쪽",
    "infra": { "title": "봉인실", "jenkins": ["봉인 문양", "Jenkins 빌드"], "harbor": ["보물창고", "Harbor 이미지"], "argocd": ["전송 아치", "ArgoCD 배포"] }
  },

  "roles": {
    "_": "역할 → 로브 색. 렌더러가 옷 픽셀의 색상만 바꾼다. 이름은 DB · 디스패처와 같다(11-05 통일). 미리 보기 ?roles=demo",
