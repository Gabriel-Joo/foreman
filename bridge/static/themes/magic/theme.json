      "potion": { "_": "C 물약실(bash) — 화로 · 재료 · 유리병", "face": "up", "seats": [[2.6, 2.4], [1.8, 3.4], [3.3, 3.4]] },
      "test": { "_": "D 시약대(test) — 시험관", "face": "down", "seats": [[2.1, 1.1], [3.1, 1.1]] },
